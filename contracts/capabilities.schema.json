{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edit.ac/contracts/capabilities/v1",
  "title": "Reviewed capability and compatibility profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "id",
    "implementation",
    "versions",
    "platform",
    "resources",
    "capabilities",
    "converters",
    "inputs",
    "evidence"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "package",
        "version"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticSchema",
        "updateSync",
        "updateEncoding",
        "extensionDescriptor",
        "publicApi",
        "nativeAbi",
        "sourceDialect"
      ],
      "properties": {
        "semanticSchema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "updateSync": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9.-]*$"
        },
        "updateEncoding": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "extensionDescriptor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "publicApi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "nativeAbi": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "sourceDialect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9.-]*$"
        }
      }
    },
    "platform": {
      "enum": [
        "portable",
        "browser",
        "terminal",
        "swift-ios",
        "kotlin-android",
        "desktop"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified",
        "limits",
        "evidence"
      ],
      "properties": {
        "qualified": {
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "minProperties": 1,
          "maxProperties": 64
        },
        "evidence": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9.-]*$"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "permissions",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "available",
              "enabled",
              "authorized",
              "qualified"
            ],
            "properties": {
              "available": {
                "type": "boolean"
              },
              "enabled": {
                "type": "boolean"
              },
              "authorized": {
                "type": "null"
              },
              "qualified": {
                "type": "boolean"
              }
            }
          },
          "permissions": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]*$"
            }
          },
          "evidence": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]*$"
            }
          }
        }
      }
    },
    "converters": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "direction",
          "fidelity",
          "capability",
          "evidence",
          "version"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "direction": {
            "enum": [
              "import",
              "export"
            ]
          },
          "fidelity": {
            "enum": [
              "lossless",
              "lossy",
              "source-preserving"
            ]
          },
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "evidence": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]*$"
            }
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "revision",
          "implementationRevision",
          "scopes",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "implementationRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "scopes": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9.-]*$"
            }
          },
          "provenance": {
            "enum": [
              "prepared",
              "target-runtime-virtual",
              "target-runtime-physical"
            ]
          }
        }
      }
    }
  }
}

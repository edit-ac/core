{
  "name": "@edit-ac/web",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent editor surface, storage, synchronization and optional modules",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/edit-ac/core.git",
    "directory": "packages/web"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./math": {
      "types": "./dist/modules/math.d.ts",
      "import": "./dist/modules/math.js",
      "default": "./dist/modules/math.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js",
      "default": "./dist/modules/index.js"
    },
    "./links": {
      "types": "./dist/modules/links/index.d.ts",
      "import": "./dist/modules/links/index.js",
      "default": "./dist/modules/links/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node ../../scripts/build-math-assets.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "katex": "0.19.0"
  },
  "dependencies": {
    "@edit-ac/core": "0.0.0"
  }
}

      ]
    },
    "web-task-workspace": {
      "parent": "PWE-1.2",
      "command": [
        "node",
        "tests/scenarios/workspace.mjs"
      ],
      "fixtures": [
        "examples/task-editor/index.html",
        "examples/task-editor/editor.mjs",
        "examples/task-editor/document.mjs",
        "examples/task-editor/markdown.mjs",
        "examples/task-editor/recovery.mjs",
        "examples/task-editor/workspace.mjs"
      ],
      "cases": [
